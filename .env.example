# Copy to .env and fill in. .env is git-ignored. Never commit keys.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Optional overrides
# NEBIUS_MODEL_FAST=
# NEBIUS_MODEL_REASON=
# NEBIUS_MODEL_HEAVY=
# TAVILY_MODE=live                # live | replay (answer from cache only)
# TAVILY_CREDIT_BUDGET=150        # max live Tavily searches ever (cumulative ledger)
# AEGIS_MAX_QUERIES=2             # Tavily queries per incident
# AEGIS_TAVILY_RESULTS=3          # results per query
# Hosted demo: AEGIS_PUBLIC=1  AEGIS_LIVE_BUDGET=12  AEGIS_COOLDOWN=30
